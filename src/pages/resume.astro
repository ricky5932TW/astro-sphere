---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"

const RESUME = {
  TITLE: "履歷",
  DESCRIPTION: "陳志豪的個人履歷，全端軟體工程師。",
}

const skills = {
  frontend: ["React", "Next.js", "TypeScript", "Vue.js", "Tailwind CSS", "HTML/CSS"],
  backend: ["Node.js", "Express", "Python", "PostgreSQL", "Redis", "Prisma"],
  devops: ["Docker", "AWS (EC2, S3, Lambda)", "GitHub Actions", "CI/CD", "Nginx"],
  tools: ["Git", "Figma", "Jira", "Postman", "Webpack", "Vite"],
}

const education = [
  {
    school: "國立臺灣大學",
    degree: "資訊工程學系 學士",
    period: "2014 – 2018",
    notes: ["GPA 3.8 / 4.0", "畢業專題：以機器學習預測股市短期波動"],
  },
]

const certificates = [
  { name: "AWS Certified Developer – Associate", issuer: "Amazon Web Services", year: "2023" },
  { name: "Google Professional Cloud Developer", issuer: "Google Cloud", year: "2022" },
]
---

<PageLayout title={RESUME.TITLE} description={RESUME.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      履歷
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate space-y-12">

      <!-- 個人資訊 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          個人資訊
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
          <div><span class="font-medium text-black dark:text-white">姓名：</span>陳志豪</div>
          <div><span class="font-medium text-black dark:text-white">居住地：</span>台北市，台灣</div>
          <div>
            <span class="font-medium text-black dark:text-white">Email：</span>
            <a href="mailto:chih.hao.chen@example.com" class="underline hover:text-black dark:hover:text-white blend">
              chih.hao.chen@example.com
            </a>
          </div>
          <div>
            <span class="font-medium text-black dark:text-white">GitHub：</span>
            <a href="https://github.com/ricky5932TW" target="_blank" class="underline hover:text-black dark:hover:text-white blend">
              github.com/ricky5932TW
            </a>
          </div>
          <div>
            <span class="font-medium text-black dark:text-white">LinkedIn：</span>
            <a href="https://www.linkedin.com/in/chih-hao-chen/" target="_blank" class="underline hover:text-black dark:hover:text-white blend">
              linkedin.com/in/chih-hao-chen
            </a>
          </div>
          <div><span class="font-medium text-black dark:text-white">語言：</span>中文（母語）、英文（流利）</div>
        </div>
      </section>

      <!-- 求職目標 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          求職目標
        </h2>
        <p class="text-sm leading-relaxed">
          擁有五年以上全端開發經驗，熟悉 React、Node.js 與雲端服務。曾帶領小型工程團隊，具備從需求分析到部署維運的完整能力。
          目前積極尋找<strong>全端工程師</strong>或<strong>前端工程師</strong>職缺，期待加入注重技術品質、持續學習的工程文化，共同打造對用戶有價值的產品。
        </p>
      </section>

      <!-- 技術能力 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          技術能力
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <p class="font-medium text-black dark:text-white mb-2">前端</p>
            <div class="flex flex-wrap gap-2">
              {skills.frontend.map(s => (
                <span class="px-2 py-0.5 rounded border border-black/15 dark:border-white/20 text-xs">{s}</span>
              ))}
            </div>
          </div>
          <div>
            <p class="font-medium text-black dark:text-white mb-2">後端 & 資料庫</p>
            <div class="flex flex-wrap gap-2">
              {skills.backend.map(s => (
                <span class="px-2 py-0.5 rounded border border-black/15 dark:border-white/20 text-xs">{s}</span>
              ))}
            </div>
          </div>
          <div>
            <p class="font-medium text-black dark:text-white mb-2">DevOps & 雲端</p>
            <div class="flex flex-wrap gap-2">
              {skills.devops.map(s => (
                <span class="px-2 py-0.5 rounded border border-black/15 dark:border-white/20 text-xs">{s}</span>
              ))}
            </div>
          </div>
          <div>
            <p class="font-medium text-black dark:text-white mb-2">工具</p>
            <div class="flex flex-wrap gap-2">
              {skills.tools.map(s => (
                <span class="px-2 py-0.5 rounded border border-black/15 dark:border-white/20 text-xs">{s}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 工作經歷 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          工作經歷
        </h2>
        <ul class="space-y-8 text-sm">
          <li>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
              <div>
                <p class="font-semibold text-black dark:text-white">趨勢科技 Trend Micro</p>
                <p class="text-xs opacity-75">資深前端工程師</p>
              </div>
              <p class="text-xs opacity-60 shrink-0">Mar 2022 – 至今</p>
            </div>
            <ul class="mt-2 space-y-1 list-disc list-inside opacity-80">
              <li>主導以 React + TypeScript 重構舊版 AngularJS 管理後台，頁面載入速度提升 40%。</li>
              <li>設計可復用 UI 元件庫（Tailwind CSS），統一全產品線視覺規範。</li>
              <li>建置前端 CI/CD 流程（GitHub Actions + Docker），縮短部署時間至原本的 1/3。</li>
              <li>帶領三人小組，與後端團隊協作定義 REST API 介面規範。</li>
            </ul>
          </li>
          <li>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
              <div>
                <p class="font-semibold text-black dark:text-white">91APP</p>
                <p class="text-xs opacity-75">全端工程師</p>
              </div>
              <p class="text-xs opacity-60 shrink-0">Jul 2019 – Feb 2022</p>
            </div>
            <ul class="mt-2 space-y-1 list-disc list-inside opacity-80">
              <li>使用 Node.js + Express 開發後端 API，串接金流（藍新、LINE Pay）與物流服務。</li>
              <li>以 Vue.js 實作店家商品管理後台，日活躍用戶超過 5,000 名商家。</li>
              <li>優化 PostgreSQL 查詢效能，將報表生成速度從 12 秒縮短至 1.5 秒。</li>
              <li>導入 Redis 快取機制，有效降低資料庫負載達 60%。</li>
            </ul>
          </li>
          <li>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
              <div>
                <p class="font-semibold text-black dark:text-white">iKala</p>
                <p class="text-xs opacity-75">軟體工程師（實習）</p>
              </div>
              <p class="text-xs opacity-60 shrink-0">Jul 2018 – Jun 2019</p>
            </div>
            <ul class="mt-2 space-y-1 list-disc list-inside opacity-80">
              <li>以 Python（Flask）開發後端爬蟲與資料處理管線，涵蓋 Instagram、YouTube 資料抓取。</li>
              <li>以 React 實作數據視覺化儀表板，整合 Chart.js 呈現 KOL 分析報表。</li>
              <li>撰寫自動化測試（Jest + Pytest），核心模組測試覆蓋率達 80%。</li>
            </ul>
          </li>
        </ul>
      </section>

      <!-- 學歷 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          學歷
        </h2>
        <ul class="space-y-4 text-sm">
          {education.map(edu => (
            <li>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                <div>
                  <p class="font-semibold text-black dark:text-white">{edu.school}</p>
                  <p class="text-xs opacity-75">{edu.degree}</p>
                </div>
                <p class="text-xs opacity-60 shrink-0">{edu.period}</p>
              </div>
              <ul class="mt-1 list-disc list-inside opacity-80 space-y-0.5">
                {edu.notes.map(note => <li>{note}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <!-- 證照 -->
      <section>
        <h2 class="text-lg font-semibold text-black dark:text-white border-b border-black/10 dark:border-white/20 pb-2 mb-4">
          專業證照
        </h2>
        <ul class="space-y-2 text-sm">
          {certificates.map(cert => (
            <li class="flex flex-col sm:flex-row sm:justify-between gap-1">
              <div>
                <span class="font-medium text-black dark:text-white">{cert.name}</span>
                <span class="opacity-60 ml-2">— {cert.issuer}</span>
              </div>
              <span class="text-xs opacity-60 shrink-0">{cert.year}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 下載按鈕 -->
      <section class="pb-4">
        <a
          href="mailto:chih.hao.chen@example.com?subject=應徵工程師職位"
          class="inline-block py-2 px-6 rounded text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend"
        >
          📧 立即聯絡我
        </a>
      </section>

    </div>
  </BottomLayout>
</PageLayout>
